# Скопируйте этот файл в .env и заполните значениями. Файл .env НЕ попадает в git.

# --- Почта (Gmail SMTP) ---
# В Gmail нужен App Password (16 символов БЕЗ пробелов), а не обычный пароль:
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_USER=your.account@gmail.com
SMTP_PASS=abcd efgh ijkl mnop
# уберите пробелы из App Password выше; пример без пробелов: abcefghijklmnopq

# Необязательные настройки (значения по умолчанию подходят для Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=0
MAIL_FROM=

# --- Приложение ---
# Ключ шифрования TOTP-секретов (обязателен вне стенда, сгенерируйте свой):
# python -c "import secrets; print(secrets.token_hex(32))"
MFA_MASTER_KEY=

# Базовый URL для ссылок в письмах (например адрес стенда в локальной сети)
MFA_BASE_URL=http://localhost:8000
